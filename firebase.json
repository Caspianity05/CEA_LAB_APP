{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "cea-lab-system",
          "appId": "1:565970579599:android:3683bcff518978090a40fa",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "cea-lab-system",
          "configurations": {
            "android": "1:565970579599:android:3683bcff518978090a40fa",
            "ios": "1:565970579599:ios:3e25e45c9adeafa50a40fa",
            "macos": "1:565970579599:ios:3e25e45c9adeafa50a40fa",
            "web": "1:565970579599:web:0b4262a4dbc1da790a40fa",
            "windows": "1:565970579599:web:eeab40967fbda4e90a40fa"
          }
        }
      }
    }
  }
}
